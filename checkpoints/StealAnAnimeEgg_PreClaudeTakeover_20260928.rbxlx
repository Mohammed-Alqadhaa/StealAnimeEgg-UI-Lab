		<Item class="ModuleScript" referent="RBX9F5AB9704F0B45BF9D94DC187B96419C">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Owner-selected Mask pack. Visual-only, repeatable wall replacement.
return function(env)
 local pack=game.ServerStorage.MaskCandidateInspection:FindFirstChild('Mask pack')
 assert(pack,'Owner-selected Mask pack missing')
 local variants={}
 for _,p in pack:GetDescendants() do if p:IsA('BasePart') then table.insert(variants,p) end end
 table.sort(variants,function(a,b)return a:GetFullName()<b:GetFullName() end)
 assert(#variants==2,'Mask pack variants changed; inspect before replacement')
 local replacements=Instance.new('Folder');replacements.Name='OwnerMaskPack'
 local placements={{1,248,21,1,5.5},{-1,248,21,2,4.5},{1,308,21,2,4.5},{-1,308,21,1,5.5}}
 for i,v in ipairs(placements) do
  local m=Instance.new('Model');m.Name='WallMask_'..i..'_Variant'..v[4]
  local p=variants[v[4]]:Clone()
  for _,d in p:GetDescendants() do
   if not d:IsA('SpecialMesh') and not d:IsA('SurfaceAppearance') then d:Destroy() end
  end
  p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
  p.CFrame=CFrame.identity;p.Parent=m;m.PrimaryPart=p
  m:ScaleTo(v[5]);m:PivotTo(CFrame.new(v[1]*47, v[3],v[2])*CFrame.Angles(0,v[1]*math.pi/2,0))
  m:SetAttribute('OwnerSelectedPack','Mask pack');m:SetAttribute('VariantIndex',v[4]);m.Parent=replacements
 end
 assert(#replacements:GetChildren()==4)
 local prior=env:FindFirstChild('OwnerMaskPack');if prior then prior:Destroy() end
 replacements.Parent=env
 local old=env:FindFirstChild('Masks');if old then old:Destroy() end
end]]></ProtectedString>
				<string name="ScriptGuid">{CCF9A4C9-D089-4CCF-98FA-E932E28A982C}</string>
				<BinaryString name="AttributesSerialize">AQAAABEAAABfbGVtb25hZGVVbmlxdWVJZAIMAAAAYXpSSXZXcFphelJJ</BinaryString>
