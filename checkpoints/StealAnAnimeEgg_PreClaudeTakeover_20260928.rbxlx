			<Item class="Script" referent="RBX5BBF8C8D0A814ABAB3559A166D592ABE">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- Visual-only client controller; no remotes or gameplay state changes.
local RunService=game:GetService('RunService')
local model=script.Parent
local root=model:WaitForChild('AuraAnchor')
local stream1=model:FindFirstChild('AuraStream_1',true)
local stream2=model:FindFirstChild('AuraStream_2',true)
local original1=root.CFrame:ToObjectSpace(stream1.CFrame)
local original2=root.CFrame:ToObjectSpace(stream2.CFrame)
local emitters,lights={},{}
for _,v in model:GetDescendants() do
 if v:IsA('ParticleEmitter') then table.insert(emitters,v) end
 if v:IsA('PointLight') then table.insert(lights,v) end
end
local elapsed,budget,enabled=0,0,nil
local connection
connection=RunService.Heartbeat:Connect(function(dt)
 if not model:IsDescendantOf(workspace) then connection:Disconnect();return end
 budget+=dt
 if budget<1/30 then return end
 local step=budget;budget=0
 local camera=workspace.CurrentCamera
 local near=camera and (camera.CFrame.Position-root.Position).Magnitude<100
 if near~=enabled then
  enabled=near
  for _,e in emitters do e.Enabled=near end
  for _,l in lights do l.Enabled=near end
  stream1.LocalTransparencyModifier=near and 0 or 1
  stream2.LocalTransparencyModifier=near and 0 or 1
 end
 if not near then return end
 elapsed+=step
 stream1.CFrame=root.CFrame*CFrame.Angles(.09*math.sin(elapsed*.43),elapsed*.34,.07)*original1
 stream2.CFrame=root.CFrame*CFrame.new(0,.09*math.sin(elapsed*.73),0)*CFrame.Angles(-.12,-elapsed*.23,.06*math.cos(elapsed*.5))*original2
 for _,l in lights do l.Brightness= .5+.08*math.sin(elapsed*1.1) end
 model:SetAttribute('AuraTime',elapsed)
end)
]]></ProtectedString>
