				<string name="ScriptGuid">{EE6EB08F-8F1F-429B-B753-9A3FBF4D5992}</string>
				<BinaryString name="AttributesSerialize">AQAAABEAAABfbGVtb25hZGVVbmlxdWVJZAIMAAAAeU9GdzZicW95T0Z3</BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
