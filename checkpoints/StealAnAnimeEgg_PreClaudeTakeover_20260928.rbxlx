		<Item class="ModuleScript" referent="RBX555F4178E2BA4C518D0B8382E5FF30AC">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--[[
	GameConfig — central tunables for Steal an Anime Egg (PHASE 1.2).
	All balance values live here; gameplay scripts must not hardcode them.
]]

local GameConfig = {
	-- Farm assignment
	FarmCount = 7,

	-- ============================================================
	-- Muscle-driven progression (server-authoritative)
	--   Muscle is the single player-facing training stat.
	--   Muscle determines Speed and Strength:
	--     Speed    = Muscle * SpeedPerMuscle
	--     Strength = StartingStrength + Muscle * StrengthPerMuscle
	--     WalkSpeed = BaseWalkSpeed + Speed * WalkSpeedPerSpeedPoint
	--                 (clamped to [BaseWalkSpeed, MaxWalkSpeed])
	-- ============================================================
	StartingMuscle = 0,
	MuscleGainPerTrain = 1,

	SpeedPerMuscle = 1,
	StrengthPerMuscle = 1,
	StartingStrength = 1,

	BaseWalkSpeed = 16,
	WalkSpeedPerSpeedPoint = 1.25,
	MaxWalkSpeed = 40,

	-- Training validation
	TrainingCooldown = 1.0,
	MaxTrainingDistance = 12,

	-- Animation support: set to a valid "rbxassetid://<id>" to play a
	-- training animation on the character during each train interaction.
	-- An empty/invalid value must never block training gameplay.
	TrainingAnimationId = "",

	-- Boxing bag recoil feedback (temporary visual only)
	BagRecoilStuds = 0.9,
	BagRecoilOutTime = 0.12,
	BagRecoilBackTime = 0.45,

	-- Farm containment: "inside" = strictly within plot bounds inset by this epsilon.
	-- The same epsilon gates steal checks and deposit checks (shared boundary rule).
	FarmBoundaryEpsilon = 0.5,

	-- PROVISIONAL egg size strength requirements (PHASE 2 will finalize; tuning only).
	EggSizeStrengthRequirements = {
		SMALL = 0,
		MEDIUM = 10,
		LARGE = 25,
	},
}

return GameConfig]]></ProtectedString>
				<string name="ScriptGuid">{A6B233CA-78AE-4212-A69F-8F10C79EA991}</string>
