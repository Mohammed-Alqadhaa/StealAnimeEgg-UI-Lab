				<ProtectedString name="Source"><![CDATA[--[[
	Phase1Init — boots the PHASE 1 foundation services in order.
	Farm + training foundation only; egg gameplay comes later.
]]

local ServerScriptService = game:GetService("ServerScriptService")

local FarmService = require(ServerScriptService.FarmService)
local PlayerStatsService = require(ServerScriptService.PlayerStatsService)
local TrainingService = require(ServerScriptService.TrainingService)

FarmService.Init()
PlayerStatsService.Init()
TrainingService.Init()

print("[Phase1] farm + training foundation online")]]></ProtectedString>
