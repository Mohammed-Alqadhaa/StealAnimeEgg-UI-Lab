	icons = {
		arm = "rbxassetid://134595823778256",
		egg = "rbxassetid://113316632422703",
		rebirth = "rbxassetid://80234316052758",
		shop = "rbxassetid://110972987269284",
		paw = "rbxassetid://88750231673471",
		book = "rbxassetid://117316658726625",
