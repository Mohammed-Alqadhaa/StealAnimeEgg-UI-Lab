	name.TextXAlignment = Enum.TextXAlignment.Center
	local pill, pillFace = makeBevel(face, "Rarity", rarityColors[d.rarity], UDim2.new(1, -24, 0, 28), UDim2.new(0, 12, 0, 244), 0.94, 40)
	pill.ZIndex = 14
	pillFace.ZIndex = 15
	local star = makeIcon(pillFace, CONFIG.icons.star, 17, UDim2.new(0, 6, 0.5, 0), 16)
	star.AnchorPoint = Vector2.new(0.5, 0.5)
	local rLabel = makeLabel(pillFace, d.rarity, UDim2.new(0.72, 0, 0.62, 0), UDim2.new(0.28, 0, 0.5, 0), 16, 2.5)
	rLabel.AnchorPoint = Vector2.new(0, 0.5)
end

