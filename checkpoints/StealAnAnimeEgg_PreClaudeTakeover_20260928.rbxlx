local function makeCharacterCard(order, data)
	local base, face = makeBevel(gridFrame, "Card_" .. data.name, data.color, UDim2.fromOffset(172, 252), UDim2.fromOffset(0, 0), 0.94, 110)
	base.LayoutOrder = order
	base.ZIndex = 12
	face.ZIndex = 13
	local art = Instance.new("Frame")
	art.Name = "Art"
	art.BackgroundColor3 = darken(data.color, 0.6)
	art.BorderSizePixel = 0
	art.AnchorPoint = Vector2.new(0.5, 0)
	art.Position = UDim2.new(0.5, 0, 0, 10)
	art.Size = UDim2.fromOffset(160, 160)
	art.ZIndex = 14
	art.Parent = face
	local aStroke = Instance.new("UIStroke")
	aStroke.Color = Color3.new(0, 0, 0)
	aStroke.Thickness = 3
	aStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	aStroke.Parent = art
	local rays = Instance.new("ImageLabel")
	rays.BackgroundTransparency = 1
	rays.Image = CONFIG.icons.sunburst
	rays.ImageTransparency = data.locked and 0.75 or 0.45
	rays.ScaleType = Enum.ScaleType.Fit
	rays.Size = UDim2.new(1, 0, 1, 0)
	rays.ZIndex = 15
	rays.Parent = art
	local portrait = makeIcon(art, CONFIG.icons.silhouette, 122, UDim2.new(0.5, 0, 0.5, 0), 16)
	portrait.AnchorPoint = Vector2.new(0.5, 0.5)
	if data.locked then
		local shade = Instance.new("Frame")
		shade.Name = "LockedShade"
		shade.BackgroundColor3 = Color3.new(0, 0, 0)
		shade.BackgroundTransparency = 0.42
		shade.BorderSizePixel = 0
		shade.Size = UDim2.new(1, 0, 1, 0)
		shade.ZIndex = 17
		shade.Parent = art
		makeIcon(art, CONFIG.icons.lock, 40, UDim2.new(1, -46, 0, 6), 18)
	end
	local name = makeLabel(face, data.name, UDim2.new(1, -12, 0, 32), UDim2.new(0, 6, 0, 174), 14, 3)
	name.TextXAlignment = Enum.TextXAlignment.Center
	local pill, pillFace = makeBevel(face, "Rarity", rarityColors[data.rarity], UDim2.new(1, -24, 0, 28), UDim2.new(0, 12, 0, 210), 0.94, 40)
	pill.ZIndex = 14
	pillFace.ZIndex = 15
	local star = makeIcon(pillFace, CONFIG.icons.star, 17, UDim2.new(0, 6, 0.5, 0), 16)
	star.AnchorPoint = Vector2.new(0.5, 0.5)
	local rLabel = makeLabel(pillFace, data.rarity, UDim2.new(0.72, 0, 0.62, 0), UDim2.new(0.28, 0, 0.5, 0), 16, 2.5)
	rLabel.AnchorPoint = Vector2.new(0, 0.5)
end

for i, data in characters do
	makeCharacterCard(i, data)
end

makeLabel(idxContent, "Steal eggs in the Demon Slayer zone to discover new characters!", UDim2.new(1, -8, 0, 30), UDim2.new(0, 4, 0, 344), 12, 2.5)

-- ================= PLACEHOLDER WINDOWS =================
local function makeShineFace(face, color)
	local grad = face:FindFirstChildOfClass("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(0.1, color:Lerp(Color3.new(1, 1, 1), 0.75)),
		ColorSequenceKeypoint.new(1, color),
	})
end

local function makePricePill(parent, iconId, price, size, position)
	local green = Color3.fromRGB(46, 170, 90)
	local base, face = makeBevel(parent, "Price", green, size, position, 0.90, 36, true)
	base.ZIndex = 14
	face.ZIndex = 15
	makeShineFace(face, green)
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.AnchorPoint = Vector2.new(0.5, 0.5)
	row.Position = UDim2.fromScale(0.5, 0.5)
	row.Size = UDim2.new(1, 0, 0.62, 0)
	row.ZIndex = 16
	row.Parent = face
	local rowList = Instance.new("UIListLayout")
	rowList.FillDirection = Enum.FillDirection.Horizontal
	rowList.HorizontalAlignment = Enum.HorizontalAlignment.Center
	rowList.VerticalAlignment = Enum.VerticalAlignment.Center
	rowList.Padding = UDim.new(0, 6)
	rowList.Parent = row
	local icon = makeIcon(row, iconId, 24, UDim2.fromOffset(0, 0), 17)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = CONFIG.font
	label.Text = price
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextScaled = true
	label.Size = UDim2.new(0.5, 0, 1, 0)
	label.ZIndex = 17
	label.Parent = row
	local s = Instance.new("UIStroke")
	s.Color = Color3.new(0, 0, 0)
	s.Thickness = 2.5
	s.Parent = label
	addPressFeedback(base)
	return base
end

local function makeProductCard(parent, order, size, data)
	local base, face = makeBevel(parent, "Card_" .. data.name, data.color, size, UDim2.fromOffset(0, 0), 0.94, 60)
	base.LayoutOrder = order
	base.ZIndex = 12
	face.ZIndex = 13
	local name = makeLabel(face, data.name, UDim2.new(1, -12, 0, 30), UDim2.new(0, 6, 0, 8), 14, 3)
	name.TextXAlignment = Enum.TextXAlignment.Center
	local art = Instance.new("Frame")
	art.Name = "Art"
	art.BackgroundColor3 = darken(data.color, 0.6)
	art.BorderSizePixel = 0
	art.AnchorPoint = Vector2.new(0.5, 0)
	art.Position = UDim2.new(0.5, 0, 0, 44)
	art.Size = UDim2.fromOffset(120, 120)
	art.ZIndex = 14
	art.Parent = face
	local aStroke = Instance.new("UIStroke")
	aStroke.Color = Color3.new(0, 0, 0)
	aStroke.Thickness = 3
	aStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	aStroke.Parent = art
	local rays = Instance.new("ImageLabel")
	rays.BackgroundTransparency = 1
	rays.Image = CONFIG.icons.sunburst
	rays.ImageTransparency = 0.45
	rays.ScaleType = Enum.ScaleType.Fit
	rays.Size = UDim2.new(1, 0, 1, 0)
	rays.ZIndex = 15
	rays.Parent = art
	local artSize = art.Size.Width.Offset - 28
	makeIcon(art, data.icon, artSize, UDim2.new(0.5, 0, 0.5, 0), 16).AnchorPoint = Vector2.new(0.5, 0.5)
	local btnY = 44 + artSize + 12
	makePricePill(face, data.priceIcon, data.price, UDim2.new(1, -16, 0, 50), UDim2.new(0, 8, 0, btnY))
	return base, face
end

