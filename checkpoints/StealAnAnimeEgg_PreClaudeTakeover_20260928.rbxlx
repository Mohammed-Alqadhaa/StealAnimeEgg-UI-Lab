-- layout: hud-zone-system (bottom-left stat chip, studded-blocky-cartoon theme)
--[[
	MuscleHud — bottom-left Muscle readout for the player.
	Displays the server-authoritative Muscle attribute (client NEVER writes it)
	and pops a "+1" feedback + scale pulse whenever Muscle increases.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "MuscleHud"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = playerGui

-- ============================================================
-- Bottom-left zone container (edge-anchored, safe inset >= 2%)
-- ============================================================
local zone = Instance.new("Frame")
zone.Name = "BottomLeftZone"
zone.AnchorPoint = Vector2.new(0, 1)
zone.Position = UDim2.new(0.025, 6, 0.975, -8)
zone.Size = UDim2.new(0.16, 0, 0.055, 0)
zone.BackgroundTransparency = 1
zone.Parent = screenGui

-- ============================================================
-- Muscle chip: 4-layer bevel stack (base + face + studs + content)
-- ============================================================
local chip = Instance.new("Frame")
chip.Name = "MuscleChip"
chip.BackgroundColor3 = Color3.fromRGB(60, 12, 12)
chip.BorderSizePixel = 0
chip.Size = UDim2.fromScale(1, 1)
chip.Parent = zone

local chipStroke = Instance.new("UIStroke")
chipStroke.Color = Color3.new(0, 0, 0)
chipStroke.Thickness = 4
chipStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
chipStroke.Parent = chip

local face = Instance.new("Frame")
face.Name = "Face"
face.BackgroundColor3 = Color3.new(1, 1, 1)
face.BorderSizePixel = 0
face.Size = UDim2.new(1, 0, 0.94, 0)
face.ZIndex = 2
face.Parent = chip

local faceGradient = Instance.new("UIGradient")
faceGradient.Rotation = 90
faceGradient.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
	ColorSequenceKeypoint.new(0.35, Color3.fromRGB(239, 28, 28)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(198, 16, 16)),
})
faceGradient.Parent = face

local studs = Instance.new("ImageLabel")
studs.Name = "Studs"
studs.BackgroundTransparency = 1
studs.Image = "rbxassetid://92521981645530"
studs.ImageTransparency = 0.55
studs.Size = UDim2.fromScale(1, 1)
studs.ScaleType = Enum.ScaleType.Tile
studs.TileSize = UDim2.fromOffset(40, 40)
studs.ZIndex = 3
studs.Parent = face

-- Muscle icon (left, Fit, aspect-locked)
local icon = Instance.new("ImageLabel")
icon.Name = "MuscleIcon"
icon.BackgroundTransparency = 1
icon.Image = "rbxassetid://134595823778256"
icon.AnchorPoint = Vector2.new(0, 0.5)
icon.Position = UDim2.new(0.04, 0, 0.5, 0)
icon.Size = UDim2.new(0.28, 0, 0.78, 0)
icon.ScaleType = Enum.ScaleType.Fit
icon.ZIndex = 4
icon.Parent = face

local iconAspect = Instance.new("UIAspectRatioConstraint")
iconAspect.AspectRatio = 1
iconAspect.DominantAxis = Enum.DominantAxis.Height
iconAspect.Parent = icon

-- Muscle value (large, gold gradient display number)
local valueLabel = Instance.new("TextLabel")
valueLabel.Name = "MuscleValue"
valueLabel.BackgroundTransparency = 1
valueLabel.Font = Enum.Font.FredokaOne
valueLabel.Text = "0"
valueLabel.TextColor3 = Color3.new(1, 1, 1)
valueLabel.TextScaled = true
valueLabel.AnchorPoint = Vector2.new(0, 0.5)
valueLabel.Position = UDim2.new(0.38, 0, 0.5, 0)
valueLabel.Size = UDim2.new(0.56, 0, 0.72, 0)
valueLabel.ZIndex = 4
valueLabel.Parent = face

local valueStroke = Instance.new("UIStroke")
valueStroke.Color = Color3.new(0, 0, 0)
valueStroke.Thickness = 3
valueStroke.Parent = valueLabel

-- ============================================================
-- Feedback: "+N" pop + value scale pulse (only when Muscle increases)
-- ============================================================
local popScale = Instance.new("UIScale")
popScale.Scale = 1
popScale.Parent = valueLabel

local POP_TWEEN = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local POP_BACK_TWEEN = TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function pulseValue()
	popScale.Scale = 1.25
	TweenService:Create(popScale, POP_BACK_TWEEN, { Scale = 1 }):Play()
end

local function showGainPop(gain)
	local pop = Instance.new("TextLabel")
	pop.Name = "MuscleGainPop"
	pop.BackgroundTransparency = 1
	pop.Font = Enum.Font.FredokaOne
	pop.Text = "+" .. gain
	pop.TextColor3 = Color3.fromRGB(255, 224, 74)
	pop.TextScaled = true
	pop.AnchorPoint = Vector2.new(0.5, 1)
	pop.Position = UDim2.new(0.5, 0, -0.15, 0)
	pop.Size = UDim2.new(0.4, 0, 0.6, 0)
	pop.ZIndex = 6
	pop.Parent = chip

	local popStroke = Instance.new("UIStroke")
	popStroke.Color = Color3.new(0, 0, 0)
	popStroke.Thickness = 2.5
	popStroke.Parent = pop

	local rise = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(pop, rise, {
		Position = UDim2.new(0.5, 0, -0.55, 0),
		TextTransparency = 1,
	}):Play()
	TweenService:Create(popStroke, rise, { Transparency = 1 }):Play()
	task.delay(0.95, function()
		pop:Destroy()
	end)
end

-- ============================================================
-- Server-authoritative state binding
-- ============================================================
local lastMuscle = nil

local function refresh(initial)
	local muscle = player:GetAttribute("Muscle") or 0
	valueLabel.Text = tostring(muscle)
	if not initial then
		if lastMuscle ~= nil and muscle > lastMuscle then
			showGainPop(muscle - lastMuscle)
			pulseValue()
		end
	end
	lastMuscle = muscle
end

player:GetAttributeChangedSignal("Muscle"):Connect(function()
	refresh(false)
end)

refresh(true)
print("[MuscleHud] bottom-left muscle HUD online (Muscle=" .. tostring(player:GetAttribute("Muscle") or 0) .. ")")]]></ProtectedString>
