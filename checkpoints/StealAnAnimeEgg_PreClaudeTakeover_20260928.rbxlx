-- ================= WINDOW MANAGER =================
local windows = {}
local currentWindow = nil
local function openWindow(name)
	if currentWindow == name then return end
	if currentWindow then windows[currentWindow].frame.Visible = false end
	currentWindow = name
	local w = windows[name]
	if not w then return end
	w.frame.Visible = true
	local pop = w.frame:FindFirstChild("PopScale")
	if pop then
		pop.Scale = 0.94
		TweenService:Create(pop, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
end

local function buildWindowShell(name, title, iconId, color, panelSize)
	local panel = Instance.new("Frame")
	panel.Name = name .. "Window"
	panel.BackgroundColor3 = Color3.new(0, 0, 0)
	panel.BackgroundTransparency = 0.40
	panel.BorderSizePixel = 0
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = panelSize
	panel.Visible = false
	panel.ZIndex = 10
	panel.Parent = root
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Thickness = 4
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = panel
	local pop = Instance.new("UIScale")
	pop.Name = "PopScale"
	pop.Parent = panel
	local bar, barFace = makeBevel(panel, "TitleBar", color, UDim2.new(1, 0, 0, 64), UDim2.new(0, 0, 0, 0), 0.88, 83)
	bar.ZIndex = 11
	barFace.ZIndex = 12
	barFace:FindFirstChildOfClass("UIGradient"):Destroy()
	local icon = makeIcon(barFace, iconId, 50, UDim2.new(0, 12, 0.5, 0), 13)
	icon.AnchorPoint = Vector2.new(0, 0.5)
	local title = makeLabel(barFace, title, UDim2.new(0.6, 0, 0.6, 0), UDim2.new(0, 74, 0.5, 0), 13, 3)
	title.AnchorPoint = Vector2.new(0, 0.5)
	title.TextXAlignment = Enum.TextXAlignment.Left
	local close = applyCloseButton(bar)
	close.ZIndex = 13
	close.MouseButton1Click:Connect(function()
		if currentWindow == name then currentWindow = nil end
		panel.Visible = false
	end)
	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.Position = UDim2.new(0, 16, 0, 64)
	content.Size = UDim2.new(1, -32, 1, -80)
	content.ZIndex = 12
	content.Parent = panel
	windows[name] = { frame = panel, content = content, color = color }
	return panel, content
end

