		<Item class="ModuleScript" referent="RBX598AB85AD3EA44408672473638EF8D84">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Width-only refinement: authored detail is translated/repeated, never globally scaled.
return function(zone)
 local source=game.ServerStorage:WaitForChild('BlenderEnvironmentTemplate')
 local env=source:Clone();env.Name='BlenderEnvironment';env.Parent=zone
 local function part(name,size,pos,collide)
  local p=Instance.new('Part');p.Name=name;p.Size=size;p.Position=pos;p.Anchored=true;p.Transparency=1;p.CanCollide=collide;p.CanTouch=false;p.CanQuery=collide;p.Parent=env;return p
 end
 local boundaryFolders={WallModules=true,Bamboo=true,Lanterns=true,River=true,Waterfalls=true,Masks=true,Rocks=true,Railings=true,Riverbed=true,Vegetation=true}
 for _,folder in env:GetChildren() do
  if boundaryFolders[folder.Name] then
   for _,p in folder:GetChildren() do if p:IsA('BasePart') then
    if p.Size.X>40 then
     -- Meshes combining both banks are archived in the source template. Use unilateral modules below.
     p:Destroy()
    else
     p.CFrame+=Vector3.new(p.Position.X>=0 and 18 or -18,0,0)
    end
   end end
  end
 end
 -- Tile the existing authored pavement across the new width; retain every tile's original aspect ratio.
 for _,p in source.Floor:GetChildren() do
  local c=p:Clone();c.CFrame+=Vector3.new(p.Position.X>=0 and 18 or -18,0,0);c.Parent=env.Floor
 end
 env.Bridge:Destroy()
 local deck=part('ContinuousWalkSurface',Vector3.new(72,1,230),Vector3.new(0,0,320),true)
 deck.Transparency=0;deck.Color=Color3.fromRGB(38,52,64);deck.Material=Enum.Material.Slate
 -- Close the widened entrance corners while preserving the existing 80-stud hub connector.
 for _,side in ipairs({-1,1}) do
  local p=part('EntranceReturnWall',Vector3.new(10,33,2),Vector3.new(side*45,16,206),true)
  p.Transparency=0;p.Material=Enum.Material.Brick;p.Color=Color3.fromRGB(28,43,64)
  local trim=part('EntranceReturnTrim',Vector3.new(10,.8,2.4),Vector3.new(side*45,32.9,206),false)
  trim.Transparency=0;trim.Material=Enum.Material.Wood;trim.Color=Color3.fromRGB(91,37,45)
 end
 -- Replace the multi-bank merged lantern roof with small individual tiered roof modules.
 for _,p in env.Lanterns:GetChildren() do
  if p:IsA('MeshPart') and p:GetAttribute('BlenderMaterial')=='Lantern warm paper' then
   -- Light anchors below remain independent of imported material naming.
  end
 end
 for _,side in ipairs({-1,1}) do for _,zz in ipairs({218,242,266,290,314,338,362,386,410}) do
  local roof=part('LanternRoofModule',Vector3.new(3.3,.45,3.3),Vector3.new(side*33.54,5.25,zz),false)
  roof.Transparency=0;roof.Material=Enum.Material.Slate;roof.Color=Color3.fromRGB(31,38,50)
 end end
 -- Both river beds have a continuous collision shell beneath overlapping imported rock shelves.
 for _,side in ipairs({-1,1}) do
  part('SolidSideBoundary',Vector3.new(2,42,230),Vector3.new(side*51,18,320),true)
  part('RiverSafetyShelf',Vector3.new(15.5,2,230),Vector3.new(side*43.25,-1.6,320),true)
  local candidates={}
  for _,p in source.Rocks:GetChildren() do if p:IsA('MeshPart') and p.Position.X*side>0 and p.Size.Z>19 and p.Position.Y<1 then table.insert(candidates,p) end end
  table.sort(candidates,function(a,b)return a.Name<b.Name end)
  for index=0,10 do
   local p=candidates[index%#candidates+1]:Clone();p.Name='RiverRockSupport_'..side..'_'..index
   p.CFrame+=Vector3.new(side*18,-3.6,210+index*22-p.Position.Z)
   p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Parent=env.Rocks
  end
  local layer=part('RiverFlowLayer',Vector3.new(10.8,.04,230),Vector3.new(side*42.45,-.26,320),false)
  layer.Transparency=.97;layer.Material=Enum.Material.Glass;layer.Color=Color3.fromRGB(20,114,145)
  local t=Instance.new('Texture');t.Name='AnimatedRiverFlow';t.Face=Enum.NormalId.Top;t.Texture='rbxassetid://97341051357596';t.StudsPerTileU=10.8;t.StudsPerTileV=14;t.Transparency=.35;t.Color3=Color3.fromRGB(100,225,250);t.Parent=layer
  for _,zz in ipairs(side==1 and {248,296,344,392} or {255,302,354,402}) do
   local anchor=part('WaterfallMotion',Vector3.one,Vector3.new(side*48,.5,zz),false)
   local top=Instance.new('Attachment');top.Position=Vector3.new(0,29,0);top.Parent=anchor
   local bottom=Instance.new('Attachment');bottom.Parent=anchor
   local beam=Instance.new('Beam');beam.Name='FlowingWaterfall';beam.Attachment0=top;beam.Attachment1=bottom;beam.Width0=5.4;beam.Width1=6;beam.FaceCamera=true;beam.Texture='rbxassetid://97341051357596';beam.TextureMode=Enum.TextureMode.Wrap;beam.TextureLength=10;beam.TextureSpeed=1.2;beam.LightEmission=.4;beam.Color=ColorSequence.new(Color3.fromRGB(65,194,229));beam.Transparency=NumberSequence.new(.4);beam.Segments=4;beam.Parent=anchor
   local spray=Instance.new('ParticleEmitter');spray.Name='WaterfallSpray';spray.Texture='rbxasset://textures/particles/smoke_main.dds';spray.Color=ColorSequence.new(Color3.fromRGB(166,221,237));spray.Rate=6;spray.Lifetime=NumberRange.new(.7,1.3);spray.Speed=NumberRange.new(1,3);spray.SpreadAngle=Vector2.new(40,40);spray.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,4)});spray.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.8),NumberSequenceKeypoint.new(1,1)});spray.Parent=bottom
  end
 end
 -- Replace the merged Torii support mesh with repeated original pillars and shoes.
 local gate=env.ToriiGate
 for _,p in gate:GetChildren() do p:Destroy() end
 for _,side in ipairs({-1,1}) do
  for _,name in ipairs({'ToriiGate_4_L_204','ToriiGate_4_L_205'}) do
   local p=source.ToriiGate[name]:Clone();p.CFrame=CFrame.new(side*(p.Position.X+18),p.Position.Y,p.Position.Z)*(side==1 and p.CFrame.Rotation or CFrame.Angles(0,math.pi,0)*p.CFrame.Rotation);p.Parent=gate
  end
 end
 -- Two authored crown modules overlap at their inner ends, keeping curved end detail intact.
 for _,side in ipairs({-1,1}) do for _,name in ipairs({'ToriiGate_0_R_208','ToriiGate_0_R_209'}) do
  local p=source.ToriiGate[name]:Clone();p.CFrame+=Vector3.new(side*17,0,0);p.Parent=gate
 end end
 local beam=part('ToriiExtendedCrossbeam',Vector3.new(70,1.74,1.8),Vector3.new(0,23.3,398),false);beam.Transparency=0;beam.Material=Enum.Material.Wood;beam.Color=Color3.fromRGB(101,39,44);beam.Parent=gate
 local tablet=part('ToriiCenterTablet',Vector3.new(2.4,4.65,.54),Vector3.new(0,26.6,396.95),false);tablet.Transparency=0;tablet.Material=Enum.Material.Slate;tablet.Color=Color3.fromRGB(25,32,40);tablet.Parent=gate
 for _,side in ipairs({-1,1}) do for _,zz in ipairs({218,242,266,290,314,338,362,386,410}) do
  local a=part('LanternLightAnchor',Vector3.one,Vector3.new(side*33.5,3.5,zz),false)
  local l=Instance.new('PointLight');l.Name='LanternWarmLight';l.Color=Color3.fromRGB(255,148,65);l.Brightness=1.25;l.Range=18;l.Shadows=false;l.Parent=a
 end end
 for zz=225,425,40 do for _,xx in ipairs({-18,18}) do
  local a=part('MoonFill',Vector3.one,Vector3.new(xx,22,zz),false)
  local l=Instance.new('PointLight');l.Color=Color3.fromRGB(105,169,220);l.Brightness=1.2;l.Range=70;l.Shadows=false;l.Parent=a
 end end
 local a=part('ArenaLightAnchor',Vector3.one,Vector3.new(0,5,368),false)
 local l=Instance.new('PointLight');l.Color=Color3.fromRGB(46,197,240);l.Brightness=1.1;l.Range=30;l.Shadows=false;l.Parent=a
 require(game.ServerStorage.ApplyOwnerMaskPack)(env)
 for _,p in env:GetDescendants() do if p:IsA('MeshPart') then p.CanCollide=false;p.CanTouch=false;p.CanQuery=false end end
 zone:SetAttribute('ZoneHalfWidth',50);zone:SetAttribute('OriginalWalkWidth',36);zone:SetAttribute('WalkWidth',72);zone:SetAttribute('OriginalWallClearWidth',64);zone:SetAttribute('WallClearWidth',100);zone:SetAttribute('OriginalMeasuredDepth',230);zone:SetAttribute('RefinedMeasuredDepth',230);zone:SetAttribute('BlenderEnvironmentReady',true)
end
]]></ProtectedString>
