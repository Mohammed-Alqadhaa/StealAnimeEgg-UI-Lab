		<Item class="Script" referent="RBX8049DA448628473FA39FA67AAB58FA93">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- GiyuWaterHashiraEgg Animation Script
-- Handles all water aura, crack glow, wave flow, and floating animations

local RunService = game:GetService("RunService")
local workspace = game:GetService("Workspace")

local model = workspace:WaitForChild("GiyuWaterHashiraEgg", 10)
if not model then return end

local shell = model:FindFirstChild("Shell")
local cracks = model:FindFirstChild("WaterCracks")
local wave = model:FindFirstChild("WaterWave")
local innerGlow = model:FindFirstChild("InnerGlow")
local foamRim = model:FindFirstChild("FoamRim")
local outerAura = model:FindFirstChild("OuterAura")

local crackLight = cracks and cracks:FindFirstChild("CrackGlow")
local waveLight = wave and wave:FindFirstChild("WaveGlow")

if not shell or not cracks or not wave then return end

-- Store base values
local baseEggPos = shell.Position
local baseWaveCFrame = wave.CFrame
local baseFoamCFrame = foamRim and foamRim.CFrame or CFrame.new()
local baseInnerSize = innerGlow and innerGlow.Size or Vector3.new(2.5, 2.5, 2.5)
local baseOuterSize = outerAura and outerAura.Size or Vector3.new(6, 6, 6)

local t = 0

RunService.Heartbeat:Connect(function(dt)
	t += dt
	
	-- === EGG FLOATING ===
	-- Gentle bobbing up and down
	local bobOffset = math.sin(t * 0.8) * 0.15
	local eggCFrame = CFrame.new(baseEggPos + Vector3.new(0, bobOffset, 0))
	-- Slow rotation
	eggCFrame = eggCFrame * CFrame.Angles(0, t * 0.1, 0)
	shell.CFrame = eggCFrame
	cracks.CFrame = eggCFrame * CFrame.new(0, -0.05, 0)
	
	-- === CRACK GLOW PULSING ===
	-- Pulsing brightness for water-energy cracks
	local crackPulse = math.sin(t * 1.5) * 0.5 + 0.5
	cracks.Color = Color3.fromRGB(
		math.floor(100 + crackPulse * 50),
		math.floor(200 + crackPulse * 40),
		255
	)
	cracks.Transparency = 0.05 + math.sin(t * 2) * 0.05
	
	-- === CRACK LIGHT ===
	if crackLight then
		crackLight.Brightness = 2 + math.sin(t * 1.5) * 1
		crackLight.Range = 10 + math.sin(t * 1.2) * 3
	end
	
	-- === WATER WAVE ROTATION ===
	-- Wave slowly orbits around the egg base
	local waveAngle = t * 0.3
	local waveOffset = Vector3.new(0, -1.5 + math.sin(t * 0.5) * 0.2, 0)
	wave.CFrame = CFrame.new(baseEggPos + waveOffset) * CFrame.Angles(0, waveAngle + math.rad(30), 0) * CFrame.Angles(math.sin(t * 0.4) * 0.1, 0, math.cos(t * 0.3) * 0.05)
	
	-- Wave color shifting
	local waveShift = math.sin(t * 0.6) * 0.5 + 0.5
	wave.Color = Color3.fromRGB(
		math.floor(15 + waveShift * 20),
		math.floor(70 + waveShift * 40),
		math.floor(170 + waveShift * 30)
	)
	wave.Transparency = 0.25 + math.sin(t * 0.8) * 0.08
	
	-- === WAVE LIGHT ===
	if waveLight then
		waveLight.Brightness = 1.5 + math.sin(t * 1.0) * 0.5
	end
	
	-- === INNER GLOW PULSING ===
	if innerGlow then
		local glowPulse = math.sin(t * 1.8) * 0.5 + 0.5
		innerGlow.Size = baseInnerSize + Vector3.new(glowPulse * 0.5, glowPulse * 0.5, glowPulse * 0.5)
		innerGlow.CFrame = CFrame.new(baseEggPos + Vector3.new(0, bobOffset, 0))
		innerGlow.Transparency = 0.5 + math.sin(t * 1.8) * 0.15
		innerGlow.Color = Color3.fromRGB(
			math.floor(0 + glowPulse * 30),
			math.floor(80 + glowPulse * 60),
			math.floor(180 + glowPulse * 50)
		)
	end
	
	-- === FOAM RIM ===
	if foamRim then
		local foamPulse = math.sin(t * 2.0) * 0.5 + 0.5
		foamRim.CFrame = CFrame.new(baseEggPos + Vector3.new(0, -1 + bobOffset, 0)) * CFrame.Angles(0, t * 0.2, 0)
		foamRim.Transparency = 0.6 + foamPulse * 0.2
		foamRim.Size = Vector3.new(4.5 + foamPulse * 0.3, 1 + foamPulse * 0.2, 4.5 + foamPulse * 0.3)
	end
	
	-- === OUTER AURA ===
	if outerAura then
		local auraPulse = math.sin(t * 0.7) * 0.5 + 0.5
		outerAura.Size = baseOuterSize + Vector3.new(auraPulse * 0.5, auraPulse * 0.5, auraPulse * 0.5)
		outerAura.CFrame = CFrame.new(baseEggPos + Vector3.new(0, bobOffset, 0))
		outerAura.Transparency = 0.90 + math.sin(t * 0.5) * 0.04
	end
end)]]></ProtectedString>
