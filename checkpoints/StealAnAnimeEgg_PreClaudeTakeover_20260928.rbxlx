		<Item class="ModuleScript" referent="RBXBBA4D3C998B44E33A8586DA11656C65E">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--[[
	PlayerStatsService — server-authoritative player progression.
	Muscle is the player-facing training stat; Speed and Strength are derived
	from it through GameConfig formulas. Stats live as Player attributes so
	the HUD can read them, but only the server writes them. Movement is
	derived server-side from the Speed stat and enforced against client writes.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("GameConfig"))

local PlayerStatsService = {}

local function computeSpeed(muscle)
	return muscle * GameConfig.SpeedPerMuscle
end

local function computeStrength(muscle)
	return GameConfig.StartingStrength + muscle * GameConfig.StrengthPerMuscle
end

local function computeWalkSpeed(speedStat)
	local walkSpeed = GameConfig.BaseWalkSpeed + speedStat * GameConfig.WalkSpeedPerSpeedPoint
	return math.clamp(walkSpeed, GameConfig.BaseWalkSpeed, GameConfig.MaxWalkSpeed)
end

-- ============================================================
-- Query API (used by future egg systems + HUD)
-- ============================================================

function PlayerStatsService.GetMuscle(player)
	local value = player:GetAttribute("Muscle")
	return value or GameConfig.StartingMuscle
end

function PlayerStatsService.GetSpeed(player)
	return computeSpeed(PlayerStatsService.GetMuscle(player))
end

function PlayerStatsService.GetStrength(player)
	return computeStrength(PlayerStatsService.GetMuscle(player))
end

function PlayerStatsService.GetEffectiveWalkSpeed(player)
	return computeWalkSpeed(PlayerStatsService.GetSpeed(player))
end

-- PROVISIONAL: thresholds live in GameConfig.EggSizeStrengthRequirements.
-- PHASE 2 will finalize egg-size carry restrictions; the API shape is stable now.
function PlayerStatsService.CanCarryEggSize(player, eggSize)
	local required = GameConfig.EggSizeStrengthRequirements[eggSize]
	if required == nil then
		return false
	end
	return PlayerStatsService.GetStrength(player) >= required
end

-- ============================================================
-- Mutation API (server-side callers only, e.g. TrainingService)
-- ============================================================

-- Applies one training gain: Muscle increases, then Speed, Strength and the
-- effective WalkSpeed are all recalculated from Muscle and pushed immediately.
function PlayerStatsService.ApplyTrainingGains(player)
	local newMuscle = PlayerStatsService.GetMuscle(player) + GameConfig.MuscleGainPerTrain
	local newSpeed = computeSpeed(newMuscle)
	local newStrength = computeStrength(newMuscle)
	player:SetAttribute("Muscle", newMuscle)
	player:SetAttribute("Speed", newSpeed)
	player:SetAttribute("Strength", newStrength)
	PlayerStatsService.ApplyMovement(player)
	return newMuscle, newSpeed, newStrength
end

function PlayerStatsService.ApplyMovement(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = PlayerStatsService.GetEffectiveWalkSpeed(player)
	end
end

-- Any WalkSpeed write that does not match the server-derived value is reverted
-- immediately, so LocalScripts cannot permanently override movement speed.
local function enforceServerWalkSpeed(player, humanoid)
	humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
		local expected = PlayerStatsService.GetEffectiveWalkSpeed(player)
		if humanoid.WalkSpeed ~= expected then
			humanoid.WalkSpeed = expected
		end
	end)
end

local function onCharacterAdded(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		warn("[PlayerStats] humanoid not found for " .. player.Name)
		return
	end
	humanoid.WalkSpeed = PlayerStatsService.GetEffectiveWalkSpeed(player)
	enforceServerWalkSpeed(player, humanoid)
end

local function initPlayer(player)
	player:SetAttribute("Muscle", GameConfig.StartingMuscle)
	player:SetAttribute("Speed", computeSpeed(GameConfig.StartingMuscle))
	player:SetAttribute("Strength", computeStrength(GameConfig.StartingMuscle))
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		onCharacterAdded(player, player.Character)
	end
end

function PlayerStatsService.Init()
	Players.PlayerAdded:Connect(initPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		initPlayer(player)
	end
	print("[PlayerStats] progression service online (Muscle-driven)")
end

return PlayerStatsService]]></ProtectedString>
				<string name="ScriptGuid">{606C77D8-3A76-442B-A40A-8B65F80FAFE0}</string>
				<BinaryString name="AttributesSerialize">AQAAABEAAABfbGVtb25hZGVVbmlxdWVJZAIMAAAAaHRZN0lVMlVodFk3</BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">PlayerStatsService</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">221aa1e16cff64100aca82f100000ace</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX2CA5F7A4B8804DF2898A48C4A9EC4D88">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--[[
	TrainingService — one reusable training system for all 7 farm boxing bags.
	Installs a ProximityPrompt on each registered bag and validates every
	train attempt server-side (own farm only, distance, valid farm, cooldown,
	living character). Stat gains are never trusted from the client.
	Muscle is the progression stat; Speed/Strength/WalkSpeed are recalculated
	by PlayerStatsService from GameConfig formulas on every accepted train.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local TweenService = game:GetService("TweenService")

local GameConfig = require(ReplicatedStorage:WaitForChild("GameConfig"))
local FarmService = require(ServerScriptService.FarmService)
local PlayerStatsService = require(ServerScriptService.PlayerStatsService)

local TrainingService = {}

local lastTrainTime = {} -- [userId] = os.clock() of last ACCEPTED training
local bagOriginalCFrame = {} -- [bagPart] = CFrame captured at prompt install

local function validateTraining(player, bagPart)
	if not player or not player.Parent then
		return false, "invalid player"
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false, "no living character"
	end
	local farmIndex = bagPart and bagPart.Parent and bagPart.Parent:GetAttribute("FarmIndex")
	if not farmIndex or not FarmService.GetFarmModel(farmIndex) then
		return false, "bag does not belong to a registered farm"
	end
	-- OWNER RULE: a player can only train at THEIR OWN farm's boxing bag.
	local ownFarm = FarmService.GetPlayerFarm(player)
	if ownFarm ~= farmIndex then
		return false, string.format("bag belongs to Farm%d, player owns Farm%s", farmIndex, tostring(ownFarm))
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false, "no HumanoidRootPart"
	end
	local distance = (root.Position - bagPart.Position).Magnitude
	if distance > GameConfig.MaxTrainingDistance then
		return false, string.format("too far (%.1f studs > %d)", distance, GameConfig.MaxTrainingDistance)
	end
	local last = lastTrainTime[player.UserId]
	if last and (os.clock() - last) < GameConfig.TrainingCooldown then
		return false, string.format("cooldown active (%.2fs left)", GameConfig.TrainingCooldown - (os.clock() - last))
	end
	return true
end

-- Animation support: plays GameConfig.TrainingAnimationId when configured.
-- A missing/invalid id must never block training gameplay.
local function playTrainingAnimation(humanoid)
	local id = GameConfig.TrainingAnimationId
	if type(id) ~= "string" or id == "" then
		return
	end
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	local ok, err = pcall(function()
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local track = animator:LoadAnimation(animation)
		track.Priority = Enum.AnimationPriority.Action
		track:Play(0.1)
		track.Stopped:Connect(function()
			track:Destroy()
			animation:Destroy()
		end)
	end)
	if not ok then
		warn("[Training] training animation failed (gameplay continues): " .. tostring(err))
	end
end

-- Temporary bag feedback: a short recoil away from the trainer, then settle back.
local function recoilBag(bagPart, player)
	local original = bagOriginalCFrame[bagPart]
	if not original then
		return
	end
	local pushDir = Vector3.new(0, 0, 1)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		local flat = bagPart.Position - root.Position
		flat = Vector3.new(flat.X, 0, flat.Z)
		if flat.Magnitude > 0.05 then
			pushDir = flat.Unit
		end
	end
	local pushed = original + pushDir * GameConfig.BagRecoilStuds
	TweenService:Create(
		bagPart,
		TweenInfo.new(GameConfig.BagRecoilOutTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ CFrame = pushed }
	):Play()
	task.delay(GameConfig.BagRecoilOutTime, function()
		if bagPart.Parent then
			TweenService:Create(
				bagPart,
				TweenInfo.new(GameConfig.BagRecoilBackTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ CFrame = original }
			):Play()
		end
	end)
end

function TrainingService.AttemptTrain(player, bagPart)
	local ok, reason = validateTraining(player, bagPart)
	if not ok then
		print(string.format("[Training] rejected %s: %s", player and player.Name or "?", reason))
		return false
	end

	lastTrainTime[player.UserId] = os.clock()
	local muscle, speed, strength = PlayerStatsService.ApplyTrainingGains(player)
	playTrainingAnimation(player.Character and player.Character:FindFirstChildOfClass("Humanoid"))
	recoilBag(bagPart, player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	print(string.format(
		"[Training] %s trained on own Farm%s bag: Muscle=%d Speed=%d Strength=%d WalkSpeed=%.1f",
		player.Name,
		tostring(bagPart.Parent:GetAttribute("FarmIndex")),
		muscle,
		speed,
		strength,
		humanoid and humanoid.WalkSpeed or PlayerStatsService.GetEffectiveWalkSpeed(player)
	))
	return true
end

function TrainingService.Init()
	for index = 1, GameConfig.FarmCount do
		local bag = FarmService.GetBagPart(index)
		if bag then
			bagOriginalCFrame[bag] = bag.CFrame
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "TrainPrompt"
			prompt.ActionText = "TRAIN"
			prompt.ObjectText = "Boxing Bag"
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = GameConfig.MaxTrainingDistance
			prompt.RequiresLineOfSight = false
			prompt.Parent = bag
			prompt.Triggered:Connect(function(player)
				TrainingService.AttemptTrain(player, bag)
			end)
		else
			warn("[Training] missing boxing bag on Farm" .. index)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		lastTrainTime[player.UserId] = nil
	end)
	print("[Training] prompts installed on all farm bags")
end

return TrainingService]]></ProtectedString>
