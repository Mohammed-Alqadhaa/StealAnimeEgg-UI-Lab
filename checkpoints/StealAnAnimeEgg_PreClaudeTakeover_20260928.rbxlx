		cat = "rbxassetid://136373929646470",
		dog = "rbxassetid://94785235613863",
		bunny = "rbxassetid://97628616133746",
	},
	font = Enum.Font.FredokaOne,
}

local function darken(c, f)
	return Color3.new(c.R * f, c.G * f, c.B * f)
end

local function makeBevel(parent, name, color, size, position, faceH, tileSize, isButton)
	local base
	if isButton then
		base = Instance.new("TextButton")
		base.Text = ""
		base.AutoButtonColor = false
	else
		base = Instance.new("Frame")
	end
	base.Name = name
	base.BackgroundColor3 = darken(color, 0.42)
	base.BorderSizePixel = 0
	base.Size = size
	base.Position = position
	base.ZIndex = 1
	base.Parent = parent
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Thickness = 4
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = base
	local face = Instance.new("Frame")
	face.Name = "Face"
	face.BackgroundColor3 = Color3.new(1, 1, 1)
	face.BorderSizePixel = 0
	face.Position = UDim2.new(0, 0, 0, 0)
	face.Size = UDim2.new(1, 0, faceH, 0)
	face.ZIndex = 2
	face.Parent = base
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(Color3.new(1, 1, 1), color)
	grad.Parent = face
	local pattern = Instance.new("ImageLabel")
	pattern.Name = "Studs"
	pattern.BackgroundTransparency = 1
	pattern.Image = "rbxassetid://92521981645530"
	pattern.ImageTransparency = 0.55
	pattern.ScaleType = Enum.ScaleType.Tile
	pattern.TileSize = UDim2.fromOffset(tileSize, tileSize)
	pattern.Size = UDim2.new(1, 0, 1, 0)
	pattern.ZIndex = 3
	pattern.Parent = face
	return base, face
end

local function makeLabel(parent, text, size, position, zIndex, strokeThickness)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = CONFIG.font
	label.Text = text
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextScaled = true
	label.Size = size
	label.Position = position
	label.ZIndex = zIndex
	label.Parent = parent
	local s = Instance.new("UIStroke")
	s.Color = Color3.new(0, 0, 0)
	s.Thickness = strokeThickness or 3
	s.Parent = label
	return label
end

local function makeIcon(parent, imageId, px, position, zIndex)
	local img = Instance.new("ImageLabel")
	img.BackgroundTransparency = 1
	img.Image = imageId
	img.ScaleType = Enum.ScaleType.Fit
	img.Size = UDim2.fromOffset(px, px)
	img.Position = position
	img.ZIndex = zIndex
	img.Parent = parent
	local aspect = Instance.new("UIAspectRatioConstraint")
	aspect.AspectRatio = 1
	aspect.Parent = img
	return img
end

local function applyCloseButton(titleBar)
	for _, n in { "Close", "CloseButton", "Exit", "ExitButton", "ExitInventory", "X" } do
		local old = titleBar.Parent:FindFirstChild(n, true)
		if old then old:Destroy() end
	end
	local btn = Instance.new("TextButton")
	btn.Name = "Close"
	btn.Text = ""
	btn.AutoButtonColor = false
	btn.Size = UDim2.new(0.05, 0, 0.66, 0)
	btn.AnchorPoint = Vector2.new(1, 0.5)
	btn.Position = UDim2.new(1, -6, 0.5, 0)
	btn.BackgroundColor3 = Color3.fromRGB(120, 14, 14)
	btn.BorderSizePixel = 0
	btn.Parent = titleBar
	local aspect = Instance.new("UIAspectRatioConstraint")
	aspect.AspectRatio = 1
	aspect.DominantAxis = Enum.DominantAxis.Height
	aspect.Parent = btn
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Thickness = 4
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = btn
	local face = Instance.new("Frame")
	face.BackgroundColor3 = Color3.new(1, 1, 1)
	face.BorderSizePixel = 0
	face.Size = UDim2.new(1, 0, 0.90, 0)
	face.ZIndex = btn.ZIndex + 1
	face.Parent = btn
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(Color3.fromRGB(255, 130, 130), Color3.fromRGB(239, 28, 28))
	grad.Parent = face
	local x = Instance.new("TextLabel")
	x.BackgroundTransparency = 1
	x.AnchorPoint = Vector2.new(0.5, 0.5)
	x.Position = UDim2.fromScale(0.5, 0.5)
	x.Size = UDim2.fromScale(0.7, 0.7)
	x.Font = Enum.Font.FredokaOne
	x.Text = "X"
	x.TextColor3 = Color3.new(1, 1, 1)
	x.TextScaled = true
	x.ZIndex = face.ZIndex + 1
	x.Parent = face
	local xs = Instance.new("UIStroke")
	xs.Color = Color3.new(0, 0, 0)
	xs.Thickness = 3
	xs.Parent = x
	addPressFeedback(btn)
	return btn
end

local function makeGoldNumber(parent, text, size, position, zIndex, strokeThickness)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = CONFIG.font
	label.Text = text
	label.TextScaled = true
	label.Size = size
	label.Position = position
	label.ZIndex = zIndex
	label.Parent = parent
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 214, 66)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 170, 30)),
	})
	grad.Parent = label
	local s = Instance.new("UIStroke")
	s.Color = Color3.new(0, 0, 0)
	s.Thickness = strokeThickness or 4
	s.Parent = label
	return label
end

local gui = Instance.new("ScreenGui")
gui.Name = "AnimeEggUiDesign"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

local root = Instance.new("Frame")
root.Name = "Root"
root.BackgroundTransparency = 1
root.Size = UDim2.fromScale(1, 1)
root.Parent = gui

local uiScale = Instance.new("UIScale")
uiScale.Parent = root
local function updateScale()
	local vp = gui.AbsoluteSize
	uiScale.Scale = math.clamp(math.min(vp.X / 1280, vp.Y / 832), 0.45, 1.2)
end
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateScale)
updateScale()

