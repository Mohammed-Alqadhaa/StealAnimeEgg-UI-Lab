					<token name="RunContext">0</token>
					<string name="ScriptGuid">{417975B0-5D7C-4E57-BC59-23BBFB128FC0}</string>
					<BinaryString name="AttributesSerialize">AQAAABEAAABfbGVtb25hZGVVbmlxdWVJZAIMAAAAMk9DdTdhNXYyT0N1</BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">AkazaLocalAtmosphere</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">3fcbbcbba467b9630ac6984c0000042b</UniqueId>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="81">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local RunService=game:GetService('RunService')
local Players=game:GetService('Players')
local world
repeat world=workspace:FindFirstChild('FarmHubVisualPrototype');if not world or not world:GetAttribute('RuntimeAssemblyReady') then task.wait() end until world and world.Parent and world:GetAttribute('RuntimeAssemblyReady')
local zone=world:WaitForChild('SixZoneRoute'):WaitForChild('Zone1')
local env=zone:WaitForChild('BlenderEnvironment')
local flows,beams,spray,lights,glows={},{},{},{},{}
for _,o in env:GetDescendants() do
 if o:IsA('Texture') and o.Name=='AnimatedRiverFlow' then table.insert(flows,o)
 elseif o:IsA('Beam') then table.insert(beams,o)
 elseif o:IsA('ParticleEmitter') then table.insert(spray,o)
 elseif o:IsA('PointLight') then table.insert(lights,o)
 elseif o:IsA('MeshPart') and o:GetAttribute('BlenderMaterial')=='Compass luminous inlay' then table.insert(glows,o) end
end
local elapsed,acc=0,0
RunService.Heartbeat:Connect(function(dt)
 elapsed+=dt;acc+=dt;if acc<.05 then return end;acc=0
 local ch=Players.LocalPlayer.Character;local root=ch and ch:FindFirstChild('HumanoidRootPart')
 local active=root and math.abs(root.Position.X)<55 and root.Position.Z>=205 and root.Position.Z<=435
 for _,b in beams do b.Enabled=active==true end
 for _,p in spray do p.Enabled=active==true end
 for i,l in lights do local near=active and (root.Position-l.Parent.Position).Magnitude<100;l.Enabled=near==true;if l.Name=='LanternWarmLight' then l.Brightness=1.25+math.sin(elapsed*2.1+i)*.08 end end
 if not active then return end
 for _,t in flows do t.OffsetStudsV=elapsed*5%140 end
 for _,p in glows do p.Transparency=.08+.1*(.5+.5*math.sin(elapsed*2.4)) end
 env:SetAttribute('WaterAnimationTime',elapsed)
end)
]]></ProtectedString>
