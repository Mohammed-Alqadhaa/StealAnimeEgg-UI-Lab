		<Item class="ModuleScript" referent="RBX2D5C5C16C3924C70A4BDEA9475C1866C">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--[[
	FarmService — server-authoritative farm assignment + safe-zone detection.
	Owns no gameplay authority on the client. Farm Plot geometry is the
	authoritative boundary; fences are visual only.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage:WaitForChild("GameConfig"))

local FarmService = {}

local farms = {} -- [index] = { Model, Plot, Bag, MinX, MaxX, MinZ, MaxZ }
local farmByUser = {} -- [userId] = farmIndex
local userByFarm = {} -- [farmIndex] = userId

local FARM_ROOT_NAME = "FarmHubVisualPrototype"

-- InspectionWorld rebuilds the prototype folder on every server start and
-- sets RuntimeAssemblyReady=true when done. Wait for a fresh, stable build
-- so we never bind to the about-to-be-destroyed saved copy.
local function waitForFarmRoot()
	while true do
		local root = Workspace:FindFirstChild(FARM_ROOT_NAME)
		if root and root:GetAttribute("RuntimeAssemblyReady") == true then
			task.wait(0.1)
			if root.Parent == Workspace and Workspace:FindFirstChild(FARM_ROOT_NAME) == root then
				return root
			end
		end
		task.wait(0.1)
	end
end

local function registerFarm(index, model)
	local plot = model:WaitForChild("Plot")
	local bag = model:WaitForChild("BoxingBag")
	local half = plot.Size * 0.5
	local pos = plot.Position
	farms[index] = {
		Model = model,
		Plot = plot,
		Bag = bag,
		MinX = pos.X - half.X,
		MaxX = pos.X + half.X,
		MinZ = pos.Z - half.Z,
		MaxZ = pos.Z + half.Z,
	}
	model:SetAttribute("FarmIndex", index)
	model:SetAttribute("OwnerUserId", 0)
	model:SetAttribute("Occupied", false)
end

local function isInsideBounds(position, farm)
	local eps = GameConfig.FarmBoundaryEpsilon
	return position.X > farm.MinX + eps
		and position.X < farm.MaxX - eps
		and position.Z > farm.MinZ + eps
		and position.Z < farm.MaxZ - eps
end

local function getRootPosition(player)
	local character = player.Character
	if not character then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	return root and root.Position or nil
end

-- ============================================================
-- Query API (used by future steal / deposit / spawn systems)
-- ============================================================

function FarmService.GetFarmModel(index)
	return farms[index] and farms[index].Model or nil
end

function FarmService.GetBagPart(index)
	return farms[index] and farms[index].Bag or nil
end

function FarmService.GetFarmIndexForPlayer(player)
	return farmByUser[player.UserId]
end

-- Alias used by gameplay systems (training, future stealing/deposit rules).
function FarmService.GetPlayerFarm(player)
	return farmByUser[player.UserId]
end

function FarmService.GetOwnerOfFarm(index)
	return userByFarm[index]
end

function FarmService.GetAvailableFarmCount()
	local count = 0
	for index = 1, GameConfig.FarmCount do
		if not userByFarm[index] then
			count += 1
		end
	end
	return count
end

-- Returns the farm index containing the position, or nil.
function FarmService.IsPositionInsideAnyFarm(position)
	for index = 1, GameConfig.FarmCount do
		if farms[index] and isInsideBounds(position, farms[index]) then
			return index
		end
	end
	return nil
end

function FarmService.IsPlayerInsideAnyFarm(player)
	local position = getRootPosition(player)
	if not position then
		return false
	end
	return FarmService.IsPositionInsideAnyFarm(position) ~= nil
end

function FarmService.IsPlayerInsideOwnFarm(player)
	local position = getRootPosition(player)
	local index = farmByUser[player.UserId]
	if not position or not index then
		return false
	end
	return isInsideBounds(position, farms[index])
end

-- ============================================================
-- Ownership API
-- ============================================================

-- Assigns the first available farm to userId. Idempotent: returns the
-- already-owned farm if one exists. Returns nil when all farms are taken
-- (the player is never kicked; they simply stay farmless).
-- carrier is the Instance attributes are mirrored onto (normally a Player).
function FarmService.AssignFarmToUser(userId, carrier)
	local existing = farmByUser[userId]
	if existing then
		return farms[existing].Model
	end

	for index = 1, GameConfig.FarmCount do
		if not userByFarm[index] then
			userByFarm[index] = userId
			farmByUser[userId] = index
			local farm = farms[index]
			farm.Model:SetAttribute("OwnerUserId", userId)
			farm.Model:SetAttribute("Occupied", true)
			if carrier and carrier:IsA("Player") then
				carrier:SetAttribute("FarmIndex", index)
			end
			print(string.format("[FarmService] Farm%d assigned to user %d", index, userId))
			return farm.Model
		end
	end

	if carrier and carrier:IsA("Player") then
		carrier:SetAttribute("FarmIndex", 0)
	end
	print(string.format("[FarmService] no farm available for user %d (all %d occupied)", userId, GameConfig.FarmCount))
	return nil
end

function FarmService.ReleaseFarm(userId)
	local index = farmByUser[userId]
	if not index then
		return false
	end

	farmByUser[userId] = nil
	userByFarm[index] = nil

	local farm = farms[index]
	farm.Model:SetAttribute("OwnerUserId", 0)
	farm.Model:SetAttribute("Occupied", false)

	local player = Players:GetPlayerByUserId(userId)
	if player then
		player:SetAttribute("FarmIndex", 0)
	end
	print(string.format("[FarmService] Farm%d released (was user %d)", index, userId))
	return true
end

function FarmService.Init()
	local root = waitForFarmRoot()
	for index = 1, GameConfig.FarmCount do
		registerFarm(index, root:WaitForChild("Farm" .. index))
	end
	print(string.format("[FarmService] registered %d farms", GameConfig.FarmCount))

	Players.PlayerAdded:Connect(function(player)
		FarmService.AssignFarmToUser(player.UserId, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		FarmService.ReleaseFarm(player.UserId)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		FarmService.AssignFarmToUser(player.UserId, player)
	end
end

return FarmService]]></ProtectedString>
