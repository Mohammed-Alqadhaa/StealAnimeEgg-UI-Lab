				<string name="Name">AkazaBossController</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">3fcbbcbba467b9630ac6984c000003d9</UniqueId>
