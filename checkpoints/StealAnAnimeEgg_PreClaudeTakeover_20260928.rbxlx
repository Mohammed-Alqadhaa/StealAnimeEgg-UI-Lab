		<Item class="Script" referent="2">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local CHASE_DELAY = 1.0
local GIVE_UP_RADIUS = 190
local ATTACK_RANGE = 11
local ATTACK_COOLDOWN = 1.45
local HOME_TOLERANCE = 2.5
local BOSS_SPEED = 23
local MOVE_REFRESH = 0.12

-- Bind only to the newly assembled runtime world, never the saved Edit preview.
local prototype
repeat
 prototype=workspace:FindFirstChild("FarmHubVisualPrototype")
 if not prototype or not prototype:GetAttribute("RuntimeAssemblyReady") then task.wait() end
until prototype and prototype.Parent and prototype:GetAttribute("RuntimeAssemblyReady")
local zone = prototype:WaitForChild("SixZoneRoute"):WaitForChild("Zone1")
local boss = zone:WaitForChild("Akaza")
local humanoid = boss:WaitForChild("Humanoid")
local root = boss:WaitForChild("HumanoidRootPart")
local torso = boss:FindFirstChild("Torso")
local home = root.Position

humanoid.WalkSpeed = BOSS_SPEED
humanoid.AutoRotate = true
humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
root:SetNetworkOwner(nil)

local joints = {}
if torso then
	joints.Root = root:FindFirstChild("RootJoint")
	joints.RightShoulder = torso:FindFirstChild("Right Shoulder")
	joints.LeftShoulder = torso:FindFirstChild("Left Shoulder")
	joints.RightHip = torso:FindFirstChild("Right Hip")
	joints.LeftHip = torso:FindFirstChild("Left Hip")
	joints.Neck = torso:FindFirstChild("Neck")
end

local animationTracks={}
local animationLoadError
local function makePose(parent,name,cf)
	local pose=Instance.new("Pose");pose.Name=name;pose.CFrame=cf;pose.Weight=1;pose.EasingStyle=Enum.PoseEasingStyle.Cubic;pose.EasingDirection=Enum.PoseEasingDirection.InOut;pose.Parent=parent;return pose
end
local function addFrame(sequence,time,rootCF,rightArm,leftArm,rightLeg,leftLeg,headCF)
	local key=Instance.new("Keyframe");key.Time=time;key.Parent=sequence
	local rootPose=makePose(key,"HumanoidRootPart",rootCF or CFrame.new())
	local torsoPose=makePose(rootPose,"Torso",CFrame.new())
	makePose(torsoPose,"Right Arm",rightArm or CFrame.new());makePose(torsoPose,"Left Arm",leftArm or CFrame.new())
	makePose(torsoPose,"Right Leg",rightLeg or CFrame.new());makePose(torsoPose,"Left Leg",leftLeg or CFrame.new());makePose(torsoPose,"Head",headCF or CFrame.new())
end
local function buildSequence(name,looped,priority)
	local sequence=Instance.new("KeyframeSequence");sequence.Name=name;sequence.Loop=looped;sequence.Priority=priority;return sequence
end
local function loadTrack(name,sequence)
	local ok,result=pcall(function()
		local provider=game:GetService("KeyframeSequenceProvider")
		local animation=Instance.new("Animation");animation.AnimationId=provider:RegisterKeyframeSequence(sequence)
		local animator=humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator",humanoid)
		local track=animator:LoadAnimation(animation);track.Looped=sequence.Loop;track.Priority=sequence.Priority;return track
	end)
	sequence:Destroy()
	if ok then animationTracks[name]=result else animationLoadError=tostring(result);boss:SetAttribute("AnimationLoadError",animationLoadError) end
end
local idleSequence=buildSequence("AkazaIdle",true,Enum.AnimationPriority.Idle)
addFrame(idleSequence,0,CFrame.new(),CFrame.Angles(-.25,0,-.4),CFrame.Angles(-.2,0,.4),CFrame.Angles(.04,0,0),CFrame.Angles(-.04,0,0))
addFrame(idleSequence,.8,CFrame.new(0,.06,0)*CFrame.Angles(math.rad(-3),0,0),CFrame.Angles(-.34,0,-.46),CFrame.Angles(-.13,0,.46),CFrame.Angles(.01,0,0),CFrame.Angles(-.01,0,0),CFrame.Angles(0,math.rad(4),0))
addFrame(idleSequence,1.6,CFrame.new(),CFrame.Angles(-.25,0,-.4),CFrame.Angles(-.2,0,.4),CFrame.Angles(.04,0,0),CFrame.Angles(-.04,0,0))
loadTrack("Idle",idleSequence)
local runSequence=buildSequence("AkazaRun",true,Enum.AnimationPriority.Movement)
for index=0,4 do local phase=index*math.pi/2;local stride=math.sin(phase);local lift=math.abs(math.cos(phase));addFrame(runSequence,index*.125,CFrame.new(0,.12*lift,-.12)*CFrame.Angles(math.rad(-13),math.rad(3)*stride,0),CFrame.Angles(1.05*stride-.2,0,-.14),CFrame.Angles(-1.05*stride-.2,0,.14),CFrame.Angles(-1.18*stride,0,math.rad(3)*stride),CFrame.Angles(1.18*stride,0,-math.rad(3)*stride),CFrame.Angles(math.rad(-6),math.rad(-3)*stride,0)) end
loadTrack("Run",runSequence)
local attackSequence=buildSequence("AkazaAttack",false,Enum.AnimationPriority.Action)
addFrame(attackSequence,0,CFrame.new(),CFrame.Angles(-.3,0,-.3),CFrame.Angles(-.2,0,.3),CFrame.new(),CFrame.new())
addFrame(attackSequence,.2,CFrame.new(0,0,.2)*CFrame.Angles(0,math.rad(-14),0),CFrame.Angles(-1.25,.2,-.38),CFrame.Angles(.45,0,.28),CFrame.Angles(.18,0,0),CFrame.Angles(-.18,0,0))
addFrame(attackSequence,.36,CFrame.new(0,0,-.5)*CFrame.Angles(math.rad(-12),math.rad(18),0),CFrame.Angles(-2.5,.2,-.12),CFrame.Angles(.6,0,.2),CFrame.Angles(-.28,0,0),CFrame.Angles(.28,0,0))
addFrame(attackSequence,.62,CFrame.new(),CFrame.Angles(-.3,0,-.3),CFrame.Angles(-.2,0,.3),CFrame.new(),CFrame.new())
loadTrack("Attack",attackSequence)
local reactionSequence=buildSequence("AkazaReact",false,Enum.AnimationPriority.Action)
addFrame(reactionSequence,0,CFrame.new(),CFrame.Angles(-.25,0,-.4),CFrame.Angles(-.2,0,.4),CFrame.new(),CFrame.new())
addFrame(reactionSequence,.5,CFrame.new(0,.15,0)*CFrame.Angles(math.rad(-8),0,0),CFrame.Angles(-.72,0,-.66),CFrame.Angles(-.72,0,.66),CFrame.new(),CFrame.new(),CFrame.Angles(math.rad(-9),0,0))
addFrame(reactionSequence,1,CFrame.new(),CFrame.Angles(-.25,0,-.4),CFrame.Angles(-.2,0,.4),CFrame.new(),CFrame.new())
loadTrack("React",reactionSequence)
local currentTrack
local function playBossAnimation(name,fade,speed)
	local track=animationTracks[name]
	if not track then return end
	if currentTrack~=track then if currentTrack then currentTrack:Stop(fade or .16) end;currentTrack=track;track:Play(fade or .16,1,speed or 1) elseif speed then track:AdjustSpeed(speed) end
	boss:SetAttribute("ActiveAnimation",name)
end
playBossAnimation("Idle",0,1)

local state = "Idle"
local stateStarted = workspace:GetServerTimeNow()
local targetPlayer
local stolenEgg
local reactionUntil = 0
local lastAttack = 0
local lastMoveOrder = 0
local smoothedSpeed = 0

local function setState(nextState)
	if state ~= nextState then
		state = nextState
		stateStarted = workspace:GetServerTimeNow()
		boss:SetAttribute("BossState", state)
		boss:SetAttribute("StateStartedAt", stateStarted)
		if nextState=="Chase" or nextState=="Return" then playBossAnimation("Run",.14,BOSS_SPEED/18) elseif nextState=="Attack" then playBossAnimation("Attack",.08,1) elseif nextState=="React" then playBossAnimation("React",.08,1) else playBossAnimation("Idle",.2,1) end
	end
end

local function livingRoot(player)
	if not player then return nil end
	local character = player.Character
	local targetHumanoid = character and character:FindFirstChildOfClass("Humanoid")
	local targetRoot = character and character:FindFirstChild("HumanoidRootPart")
	if targetHumanoid and targetHumanoid.Health > 0 and targetRoot then return targetRoot,targetHumanoid end
	return nil
end

local function restoreEgg()
	if stolenEgg and stolenEgg.Parent then
		stolenEgg:SetAttribute("Collected",false)
		for _,descendant in stolenEgg:GetDescendants() do
			if descendant:IsA("BasePart") then descendant.Transparency=descendant.Name=="EggShellGlow" and .65 or descendant.Name=="MistHalo" and .72 or descendant.Name=="AuraOrbit" and .42 or descendant.Name=="EggBand" and .18 or 0 end
			if descendant:IsA("ParticleEmitter") then descendant.Enabled=true end
			if descendant:IsA("ProximityPrompt") then descendant.Enabled=true end
		end
	end
	stolenEgg=nil
end

local function beginReaction(player,eggModel)
	if targetPlayer then return end
	targetPlayer=player
	stolenEgg=eggModel
	local reactionStarted=workspace:GetServerTimeNow()
	reactionUntil=reactionStarted+CHASE_DELAY
	player:SetAttribute("CarryingAkazaEgg",eggModel:GetAttribute("Theme"))
	eggModel:SetAttribute("Collected",true)
	for _,descendant in eggModel:GetDescendants() do
		if descendant:IsA("BasePart") then descendant.Transparency=1 end
		if descendant:IsA("ParticleEmitter") then descendant.Enabled=false end
		if descendant:IsA("ProximityPrompt") then descendant.Enabled=false end
	end
	humanoid:Move(Vector3.zero)
	setState("React")
	boss:SetAttribute("ReactionStartedAt",reactionStarted)
	boss:SetAttribute("ReactionEndsAt",reactionUntil)
end

for _,descendant in zone:GetDescendants() do
	if descendant:IsA("ProximityPrompt") and descendant.Name=="EggCollectPrompt" then
		descendant.Triggered:Connect(function(player)
			local eggModel=descendant:FindFirstAncestorOfClass("Model")
			if eggModel and eggModel:GetAttribute("IsCollectible") and not eggModel:GetAttribute("Collected") then beginReaction(player,eggModel) end
		end)
	end
end

local function approach(current,target,maxDelta)
	local difference=target-current
	if math.abs(difference)<=maxDelta then return target end
	return current+math.sign(difference)*maxDelta
end

local function animate(now,deltaTime)
	local desiredSpeed=(state=="Chase" or state=="Return") and 1 or 0
	smoothedSpeed=approach(smoothedSpeed,desiredSpeed,deltaTime*5)
	if animationTracks.Run and (state=="Chase" or state=="Return") then animationTracks.Run:AdjustSpeed((BOSS_SPEED/18)*(.82+.18*smoothedSpeed)) end
	boss:SetAttribute("AnimationTracksLoaded",animationTracks.Idle~=nil and animationTracks.Run~=nil and animationTracks.Attack~=nil and animationTracks.React~=nil)
end

RunService.Heartbeat:Connect(function(deltaTime)
	local now=workspace:GetServerTimeNow()
	if state=="React" then
		if now>=reactionUntil then setState("Chase") end
	elseif state=="Attack" then
		if now-stateStarted>=.62 then setState(targetPlayer and "Chase" or "Return") end
	elseif targetPlayer then
		local targetRoot,targetHumanoid=livingRoot(targetPlayer)
		if not targetRoot or (targetRoot.Position-home).Magnitude>GIVE_UP_RADIUS then
			targetPlayer:SetAttribute("CarryingAkazaEgg",nil)
			targetPlayer=nil
			restoreEgg()
			setState("Return")
		else
			local distance=(targetRoot.Position-root.Position).Magnitude
			if distance<=ATTACK_RANGE and now-lastAttack>=ATTACK_COOLDOWN then
				lastAttack=now
				setState("Attack")
				humanoid:Move(Vector3.zero)
				task.delay(.34,function()
					local currentRoot,currentHumanoid=livingRoot(targetPlayer)
					if currentRoot and currentHumanoid and (currentRoot.Position-root.Position).Magnitude<=ATTACK_RANGE+3 then currentHumanoid:TakeDamage(18) end
				end)
			elseif now-lastMoveOrder>=MOVE_REFRESH then
				lastMoveOrder=now
				setState("Chase")
				humanoid:MoveTo(targetRoot.Position)
			end
		end
	else
		if (root.Position-home).Magnitude>HOME_TOLERANCE then
			setState("Return")
			if now-lastMoveOrder>=MOVE_REFRESH then lastMoveOrder=now;humanoid:MoveTo(home) end
		else
			setState("Idle")
			humanoid:Move(Vector3.zero)
		end
	end
	boss:SetAttribute("BossState",state)
	boss:SetAttribute("TargetUserId",targetPlayer and targetPlayer.UserId or 0)
	animate(now,deltaTime)
end)

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		if RunService:IsStudio() then
			local characterHumanoid=character:WaitForChild("Humanoid",10)
			if characterHumanoid then characterHumanoid.WalkSpeed=80;character:SetAttribute("StudioTestSpeed",true) end
		end
	end)
end)

for _,player in Players:GetPlayers() do
	if player.Character and RunService:IsStudio() then local h=player.Character:FindFirstChildOfClass("Humanoid");if h then h.WalkSpeed=80 end end
end
]]></ProtectedString>
