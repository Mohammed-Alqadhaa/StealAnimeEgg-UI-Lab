		<Item class="Script" referent="3">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local W,L=workspace,game:GetService("Lighting")
local old=W:FindFirstChild("FarmHubVisualPrototype"); if old then old:Destroy() end
local root=Instance.new("Folder"); root.Name="FarmHubVisualPrototype"; root.Parent=W
local C={grass1=Color3.fromRGB(126,218,31),grass2=Color3.fromRGB(108,201,24),path=Color3.fromRGB(242,183,82),band=Color3.fromRGB(220,143,45),rail=Color3.fromRGB(224,118,22),post=Color3.fromRGB(83,50,35),blue=Color3.fromRGB(47,159,255),ink=Color3.fromRGB(31,42,61)}
local function part(parent,name,size,cf,color,material,collide)
 local p=Instance.new("Part"); p.Name=name;p.Size=size;p.CFrame=cf;p.Color=color;p.Material=material or Enum.Material.SmoothPlastic;p.Anchored=true;p.CanCollide=collide~=false;p.CanTouch=p.CanCollide;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent;return p
end
local function label(parent,text,pos,width,color)
 local a=part(parent,"LabelAnchor",Vector3.one,CFrame.new(pos),Color3.new(1,1,1),nil,false);a.Transparency=1
 local g=Instance.new("BillboardGui");g.Size=UDim2.fromOffset(width or 220,52);g.AlwaysOnTop=true;g.MaxDistance=250;g.Parent=a
 local t=Instance.new("TextLabel");t.Size=UDim2.fromScale(1,1);t.BackgroundColor3=C.ink;t.BackgroundTransparency=.08;t.TextColor3=color or Color3.new(1,1,1);t.TextStrokeTransparency=.55;t.Font=Enum.Font.GothamBlack;t.TextScaled=true;t.Text=text;t.Parent=g
end
local function segment(parent,a,b)
 for _,q in ipairs({a,b}) do part(parent,"FencePost",Vector3.new(1.2,4.4,1.2),CFrame.new(q+Vector3.new(0,2.2,0)),C.post,Enum.Material.WoodPlanks,false) end
 local mid=(a+b)/2;local len=(b-a).Magnitude
 for _,y in ipairs({1.3,3.2}) do part(parent,"FenceRail",Vector3.new(.48,.48,len),CFrame.lookAt(mid+Vector3.new(0,y,0),b+Vector3.new(0,y,0)),C.rail,Enum.Material.WoodPlanks,false) end
 for _,flip in ipairs({-1,1}) do part(parent,"CrossBrace",Vector3.new(.36,.36,math.sqrt(len*len+8)),CFrame.lookAt(mid+Vector3.new(0,2.25,0),b+Vector3.new(0,2.25,0))*CFrame.Angles(flip*math.atan2(2.8,len),0,0),C.rail,Enum.Material.WoodPlanks,false) end
end
local function line(parent,a,b,opening,width)
 local d=b-a;local len=d.Magnitude;local u=d.Unit
 for x=0,len-10,10 do if not opening or math.abs(x+5-opening)>width/2 then segment(parent,a+u*x,a+u*math.min(len,x+10)) end end
end
local function pad(parent,pos,i)
 local p=part(parent,"CharacterPad"..i,Vector3.new(.8,8,8),CFrame.new(pos+Vector3.new(0,.6,0))*CFrame.Angles(0,0,math.rad(90)),i%2==0 and C.blue or Color3.fromRGB(255,235,170),Enum.Material.SmoothPlastic,true);p.Shape=Enum.PartType.Cylinder
 local h=Instance.new("Highlight");h.FillTransparency=.9;h.OutlineColor=C.ink;h.OutlineTransparency=.1;h.Parent=p
end
local function bag(parent,pos)
 part(parent,"BagBase",Vector3.new(8,1,8),CFrame.new(pos+Vector3.new(0,.5,0)),C.ink,Enum.Material.Metal,true)
 part(parent,"BagPost",Vector3.new(1,9,1),CFrame.new(pos+Vector3.new(0,5,2.6)),C.post,Enum.Material.WoodPlanks,false)
 part(parent,"BagArm",Vector3.new(1,1,5.4),CFrame.new(pos+Vector3.new(0,9,.1)),C.post,Enum.Material.WoodPlanks,false)
 part(parent,"Chain",Vector3.new(.22,2,.22),CFrame.new(pos+Vector3.new(0,7.6,-2.1)),Color3.fromRGB(70,75,82),Enum.Material.Metal,false)
 local b=part(parent,"BoxingBag",Vector3.new(3.5,5,3.5),CFrame.new(pos+Vector3.new(0,4.2,-2.1)),Color3.fromRGB(221,57,42),Enum.Material.SmoothPlastic,false);b.Shape=Enum.PartType.Cylinder
 label(parent,"TRAIN",pos+Vector3.new(0,11,0),130,Color3.fromRGB(255,224,74))
end
local function tiles(parent,center)
 for x=-42,42,7 do for z=-35,35,7 do local k=(math.floor((x+42)/7)+math.floor((z+35)/7))%2;part(parent,"GrassTile",Vector3.new(7,.3,7),CFrame.new(center+Vector3.new(x,.66+(k*.025),z)),k==0 and C.grass1 or C.grass2,Enum.Material.SmoothPlastic,true) end end
end
local function farm(i,center,face)
 local m=Instance.new("Model");m.Name="Farm"..i;m.Parent=root
 part(m,"Plot",Vector3.new(92,1,78),CFrame.new(center),C.grass2,Enum.Material.Grass,true);tiles(m,center)
 local hx,hz=46,39
 line(m,center+Vector3.new(-hx,0,-hz),center+Vector3.new(hx,0,-hz),face=="N" and hx or nil,18)
 line(m,center+Vector3.new(-hx,0,hz),center+Vector3.new(hx,0,hz),face=="S" and hx or nil,18)
 line(m,center+Vector3.new(-hx,0,-hz),center+Vector3.new(-hx,0,hz),face=="W" and hz or nil,18)
 line(m,center+Vector3.new(hx,0,-hz),center+Vector3.new(hx,0,hz),face=="E" and hz or nil,18)
 local f=face=="N" and Vector3.new(0,0,-1) or face=="S" and Vector3.new(0,0,1) or face=="E" and Vector3.new(1,0,0) or Vector3.new(-1,0,0);local s=Vector3.new(-f.Z,0,f.X)
 for n=-2,2 do pad(m,center-f*18+s*(n*15),n+3) end
 bag(m,center+f*17-s*27)
 local entry=center+f*33;part(m,"EntranceMat",Vector3.new(18,.4,12),CFrame.lookAt(entry+Vector3.new(0,.8,0),center),C.path,Enum.Material.Sand,true)
 label(m,"FARM "..i,center+Vector3.new(0,7,0),170,Color3.fromRGB(255,238,90));label(m,"ENTER",entry+Vector3.new(0,4,0),120)
end
part(root,"HubGround",Vector3.new(370,2,350),CFrame.new(0,-1,12),C.grass2,Enum.Material.Grass,true)
local spawn=Instance.new("SpawnLocation");spawn.Name="FarmHubSpawn";spawn.Size=Vector3.new(14,1,14);spawn.CFrame=CFrame.new(0,1,-112);spawn.Color=C.blue;spawn.Material=Enum.Material.Neon;spawn.Transparency=.25;spawn.Anchored=true;spawn.CanCollide=true;spawn.Neutral=true;spawn.Duration=0;spawn.Parent=root
part(root,"MainPath",Vector3.new(34,.45,340),CFrame.new(0,.25,15),C.path,Enum.Material.Sand,true)
for z=-150,175,16 do part(root,"PathBand",Vector3.new(34,.08,2),CFrame.new(0,.51,z),C.band,Enum.Material.SmoothPlastic,false) end
farm(1,Vector3.new(-110,0,-88),"E");farm(2,Vector3.new(-110,0,4),"E");farm(3,Vector3.new(-110,0,96),"E")
farm(4,Vector3.new(110,0,-88),"W");farm(5,Vector3.new(110,0,4),"W");farm(6,Vector3.new(110,0,96),"W");farm(7,Vector3.new(0,0,-140),"S")
local exit=Instance.new("Model");exit.Name="SharedWorldExit";exit.Parent=root
part(exit,"ExitFloor",Vector3.new(82,.5,24),CFrame.new(0,.3,184),C.blue,Enum.Material.SmoothPlastic,true)
for _,x in ipairs({-39,39}) do part(exit,"Post",Vector3.new(4,22,4),CFrame.new(x,11,184),C.post,Enum.Material.WoodPlanks,true) end
part(exit,"Header",Vector3.new(82,5,5),CFrame.new(0,21,184),C.rail,Enum.Material.WoodPlanks,true);label(exit,"6 ANIME ZONES",Vector3.new(0,25,184),330)
for i,col in ipairs({Color3.fromRGB(244,73,64),Color3.fromRGB(255,188,43),Color3.fromRGB(62,190,255),Color3.fromRGB(126,238,80),Color3.fromRGB(181,91,244),Color3.fromRGB(255,113,183)}) do part(exit,"ZoneMarker"..i,Vector3.new(9,.5,9),CFrame.new(-31+(i-1)*12.4,.7,184),col,Enum.Material.Neon,false) end
part(exit,"WorldConnector",Vector3.new(80,.5,18),CFrame.new(0,.3,196),C.blue,Enum.Material.SmoothPlastic,true)

local zones=Instance.new("Folder");zones.Name="SixZoneRoute";zones.Parent=root
local zoneColors={
 {Color3.fromRGB(48,166,213),Color3.fromRGB(235,91,158)},
 {Color3.fromRGB(112,82,145),Color3.fromRGB(73,67,82)},
 {Color3.fromRGB(255,190,75),Color3.fromRGB(230,112,70)},
 {Color3.fromRGB(85,205,130),Color3.fromRGB(38,139,113)},
 {Color3.fromRGB(110,145,245),Color3.fromRGB(103,76,180)},
 {Color3.fromRGB(235,105,120),Color3.fromRGB(110,53,84)},
}
local function egg(parent,pos,index,accent)
