			<Item class="LocalScript" referent="80">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local ZONE_MIN_Z = 205
local ZONE_MAX_Z = 435
local ZONE_HALF_WIDTH = 52
local TRANSITION_TIME = 1.15

local baseline = {
	Brightness = 2.25,
	ClockTime = 13.5,
	Ambient = Color3.fromRGB(130,145,156),
	OutdoorAmbient = Color3.fromRGB(165,184,196),
	ExposureCompensation = 0,
}

local grade = Instance.new("ColorCorrectionEffect")
grade.Name = "AkazaLocalNightGrade"
grade.Enabled = false
grade.TintColor = Color3.fromRGB(220, 235, 255)
grade.Brightness = 0
grade.Contrast = 0.06
grade.Saturation = -0.02
grade.Parent = Lighting

local atmosphere = Instance.new("Atmosphere")
atmosphere.Name = "AkazaLocalNightAtmosphere"
atmosphere.Color = Color3.fromRGB(78,126,181)
atmosphere.Decay = Color3.fromRGB(44,72,133)
atmosphere.Density = 0
atmosphere.Haze = 0
atmosphere.Glare = 0.08
atmosphere.Offset = 0.15
atmosphere.Parent = Lighting

local bloom = Instance.new("BloomEffect")
bloom.Name = "AkazaLocalEnergyBloom"
bloom.Intensity = 0.12
bloom.Size = 24
bloom.Threshold = 1.8
bloom.Enabled = false
bloom.Parent = Lighting

local inZone = nil
local activeTween

local function tweenLighting(properties)
	if activeTween then
		activeTween:Cancel()
	end
	-- Do not sweep through bright afternoon/sunset during the local night change.
	if properties.ClockTime then Lighting.ClockTime=properties.ClockTime;properties=table.clone(properties);properties.ClockTime=nil end
	activeTween = TweenService:Create(Lighting, TweenInfo.new(TRANSITION_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), properties)
	activeTween:Play()
end

local function setNight(enabled)
	if enabled == inZone then
		return
	end
	inZone = enabled
	Lighting:SetAttribute('AkazaNightActive',enabled)
	local prototype = workspace:FindFirstChild("FarmHubVisualPrototype")
	local zone = prototype and prototype:FindFirstChild("SixZoneRoute") and prototype.SixZoneRoute:FindFirstChild("Zone1")
	if zone then
		local moon = zone:FindFirstChild("Moon")
		if moon and moon:IsA("BasePart") then moon.LocalTransparencyModifier = enabled and 0 or 1 end
		for _, child in zone:GetChildren() do
			if child.Name:match("^MoonCrater") and child:IsA("BasePart") then child.LocalTransparencyModifier = enabled and 0 or 1 end
		end
	end
	grade.Enabled = enabled
	bloom.Enabled = enabled
	if enabled then
		atmosphere.Density = 0.12
		atmosphere.Haze = 0.5
		tweenLighting({
			Brightness = 2.25,
			ClockTime = 20.15,
			Ambient = Color3.fromRGB(135,165,215),
			OutdoorAmbient = Color3.fromRGB(135,165,215),
			ExposureCompensation = 0,
		})
	else
		atmosphere.Density = 0
		atmosphere.Haze = 0
		tweenLighting(baseline)
	end
end

RunService.Heartbeat:Connect(function()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		setNight(false)
		return
	end
	local position = root.Position
	setNight(math.abs(position.X) <= ZONE_HALF_WIDTH and position.Z >= ZONE_MIN_Z and position.Z <= ZONE_MAX_Z)
end)

player.CharacterRemoving:Connect(function()
	setNight(false)
end)
]]></ProtectedString>
					<bool name="Disabled">false</bool>
